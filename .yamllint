---
extends: default

rules:
  line-length:
    max: 160
    level: warning
  truthy: disable
  braces:
    max-spaces-inside: 1
    level: error
  brackets:
    max-spaces-inside: 1
    level: error
  comments:
    min-spaces-from-content: 1
  comments-indentation: {}
  document-start: disable
  empty-lines:
    max: 2
  hyphens:
    level: error
  indentation:
    spaces: 2
    indent-sequences: true
  key-duplicates: {}
  new-line-at-end-of-file: {}
  new-lines:
    type: unix
  trailing-spaces: {}
